+	tmp[0] = AND64H(product[11]);
+	tmp[1] = (product[10] << 32);
+	tmp[2] = product[6];
+	tmp[3] = product[7];
+	tmp[4] = product[8];
+	tmp[5] = product[9];
+	carry += vli_add(result, result, tmp, ndigits);
