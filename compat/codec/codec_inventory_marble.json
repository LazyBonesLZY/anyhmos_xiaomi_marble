  "verdict": {
    "software_audio_decode": {
      "state": "expected-ok",
      "why": "donor ships FFmpeg/opus/g711 soft audio decoder plugins inside the MediaEngine backend that av_codec_service hosts directly; no codec HDI involved",
      "must_still_verify": "CODEC_PROBE lines with type=sw for audio/* plus a real --decode run"
    },
    "software_video_decode": {
      "state": "blocked-on-this-stack",
      "why": "the only OHOS video codec plugin (libhistreamer_plugin_CodecAdapter.z.so) is a codec-HDI client, and the HDI's component list is OMX.hisi.* only; no FFmpeg video decoder plugin is shipped (media_plugins has audio plugins only)",
      "unblocked_by": "either a vendor OMX video component for SM7475 (does not exist), or an app-side decoder using chipset-sdk/libohosffmpeg.z.so (present, 7.7 MB) plus a present sink"
    },
    "android_codec2_soft_via_bionic": {
      "state": "blocked-by-missing-artifact",
      "why": "the marble dump ships libcodec2_soft_common.so but none of the libcodec2_soft_<codec>.so components; the only video soft decoders are 32-bit libstagefright_soft_* in vendor/lib, plus libcodec2_soft_common needs libstagefright_foundation + libsfplugin_ccodec_utils",
      "unblocked_by": "build AOSP libcodec2_soft_{avcdec,hevcdec} for arm64 and host them on the bionic runtime with libui/libcutils/libcodec2_vndk"
    },
    "hardware_decode_ohos_hdi": {
      "state": "blocked",
      "why": "codec_host is absent from the device HCB and the only components are Huawei OMX.hisi.* bound to a Kirin vcodec driver"
    },
    "hardware_decode_marble_venus": {
      "state": "blocked-research",
      "why": "kernel side is ready (msm_video.ko vermagic matches, vidc DT present in the flashed vendor_boot), but there is no firmware on device, no OHOS codec component that speaks V4L2/Venus, and the Android Codec2 userspace is not installed",
      "needs": [
        "vendor/firmware/vpu20_4v.{mbn,mdt,b00..b19} staged from the marble dump",
        "insmod qcom-scm/mdt_loader/mem_buf_dev/msm-mmrm/llcc-qcom/videocc-*/msm_video",
        "a V4L2 consumer on /dev/video* - neither the OHOS HDI nor the OHOS MediaEngine can act as one"
      ]
    }
  }
